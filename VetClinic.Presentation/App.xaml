<Application x:Class="VetClinic.Presentation.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:VetClinic.Presentation.Converters"
             xmlns:viewmodels="clr-namespace:VetClinic.Presentation.ViewModels"
             xmlns:views="clr-namespace:VetClinic.Presentation.Views">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/Colors.xaml" />
                <ResourceDictionary Source="Styles/Typography.xaml" />
                <ResourceDictionary Source="Styles/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Converters Globales de Presentación -->
            <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <converters:BooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" IsInverted="True" />
            <converters:DateFormatConverter x:Key="DateFormatConverter" />
            <converters:KilogramsFormatConverter x:Key="KilogramsFormatConverter" />

            <!-- Mapeo DataTemplate Implícito ViewModel -> View -->
            <DataTemplate DataType="{x:Type viewmodels:PropietariosViewModel}">
                <views:PropietariosView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewmodels:PacientesViewModel}">
                <views:PacientesView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewmodels:HistoriaClinicaViewModel}">
                <views:HistoriaClinicaView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewmodels:InmunizacionesViewModel}">
                <views:InmunizacionesView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewmodels:RecordatoriosViewModel}">
                <views:RecordatoriosView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
