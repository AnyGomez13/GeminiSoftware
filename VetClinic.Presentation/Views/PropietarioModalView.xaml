<Window x:Class="VetClinic.Presentation.Views.PropietarioModalView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:enums="clr-namespace:VetClinic.Domain.Enums;assembly=VetClinic.Domain"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Title="{Binding TituloVentana}"
        Height="540" Width="550"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource AppBackgroundBrush}">

    <Window.Resources>
        <ObjectDataProvider x:Key="TipoDocumentoValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="enums:TipoDocumento" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </Window.Resources>

    <Grid Margin="24">
        <Border Style="{StaticResource CardBorderStyle}" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Cabecera -->
                <TextBlock Grid.Row="0"
                           Text="{Binding TituloVentana}"
                           FontSize="18" FontWeight="Bold"
                           Foreground="{StaticResource DarkGreenBrush}"
                           Margin="0,0,0,16" />

                <!-- Formulario -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,8,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Tipo Documento -->
                            <StackPanel Grid.Column="0" Margin="0,0,12,12">
                                <TextBlock Text="Tipo Doc. *" Style="{StaticResource LabelTextStyle}" />
                                <ComboBox ItemsSource="{Binding Source={StaticResource TipoDocumentoValues}}"
                                          SelectedItem="{Binding TipoDocumento, Mode=TwoWay}" />
                            </StackPanel>

                            <!-- Número Documento -->
                            <StackPanel Grid.Column="1" Margin="0,0,0,12">
                                <TextBlock Text="Número de Documento *" Style="{StaticResource LabelTextStyle}" />
                                <TextBox Text="{Binding NumeroDocumento, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Nombres -->
                            <StackPanel Grid.Column="0" Margin="0,0,6,12">
                                <TextBlock Text="Nombres *" Style="{StaticResource LabelTextStyle}" />
                                <TextBox Text="{Binding Nombres, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>

                            <!-- Apellidos -->
                            <StackPanel Grid.Column="1" Margin="6,0,0,12">
                                <TextBlock Text="Apellidos *" Style="{StaticResource LabelTextStyle}" />
                                <TextBox Text="{Binding Apellidos, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>

                        <!-- Teléfono Celular (RN-04) -->
                        <TextBlock Text="Teléfono Celular / WhatsApp (10 dígitos iniciando en 3) *" Style="{StaticResource LabelTextStyle}" />
                        <TextBox Text="{Binding Telefono, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

                        <!-- Dirección -->
                        <TextBlock Text="Dirección de Residencia" Style="{StaticResource LabelTextStyle}" />
                        <TextBox Text="{Binding Direccion, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

                        <!-- Correo Electrónico -->
                        <TextBlock Text="Correo Electrónico" Style="{StaticResource LabelTextStyle}" />
                        <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

                        <!-- Mensaje de Error -->
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Foreground="{StaticResource ErrorBrush}"
                                   FontSize="13" FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,8"
                                   Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>
                </ScrollViewer>

                <!-- Barra de Acciones Inferior -->
                <Grid Grid.Row="2" Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ProgressBar Grid.Column="0" Height="4"
                                 IsIndeterminate="True"
                                 Margin="0,0,16,0"
                                 Foreground="{StaticResource PrimaryGreenBrush}"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <Button Grid.Column="1"
                            Content="Cancelar"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding CancelarCommand}"
                            Margin="0,0,8,0" />

                    <Button Grid.Column="2"
                            Content="Guardar Propietario"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding GuardarCommand}"
                            IsDefault="True" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
