<UserControl x:Class="VetClinic.Presentation.Views.RecordatoriosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="750" d:DesignWidth="1100">

    <Grid>
        <Grid.RowDefinitions>
            <!-- Filtro de Plazo y Estado de Despacho (70 px) -->
            <RowDefinition Height="Auto" />
            <!-- Cuerpo Principal: División Tabla y Previsualización -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Barra Superior de Control -->
        <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Anticipación de Alertas:"
                           Style="{StaticResource LabelTextStyle}"
                           VerticalAlignment="Center" Margin="0,0,10,0" />

                <ComboBox Grid.Column="1"
                          SelectedValuePath="Tag"
                          SelectedValue="{Binding DiasAnticipacion, Mode=TwoWay}"
                          Height="36">
                    <ComboBoxItem Content="Próximos 7 días" Tag="7" IsSelected="True" />
                    <ComboBoxItem Content="Próximos 15 días" Tag="15" />
                    <ComboBoxItem Content="Próximos 30 días" Tag="30" />
                </ComboBox>

                <ProgressBar Grid.Column="2" Height="4"
                             IsIndeterminate="True" Margin="20,0"
                             Foreground="{StaticResource PrimaryGreenBrush}"
                             Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <Border Grid.Column="3" Background="#E8F5E9" CornerRadius="12" Padding="12,6" VerticalAlignment="Center">
                    <TextBlock Text="Cero Costo de Infraestructura (WhatsApp Web / Correo Local)"
                               FontSize="12" FontWeight="Bold" Foreground="{StaticResource DarkGreenBrush}" />
                </Border>
            </Grid>
        </Border>

        <!-- División 65 / 35: Tabla de Pacientes por Notificar / Previsualización de Mensaje -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6.5*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="3.5*" />
            </Grid.ColumnDefinitions>

            <!-- Tabla de Próximos Refuerzos -->
            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="Pacientes con Refuerzo o Vacunación Próxima"
                                   FontSize="16" FontWeight="Bold"
                                   Foreground="{StaticResource DarkGreenBrush}" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding ProximosRefuerzos.Count, StringFormat='Total Alertas: {0}'}"
                                   FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" />
                    </Grid>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding ProximosRefuerzos}"
                              SelectedItem="{Binding InmunizacionSeleccionada, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              BorderThickness="1"
                              BorderBrush="{StaticResource BorderBrush}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Fecha Refuerzo" Binding="{Binding FechaRefuerzo, StringFormat='{}{0:dd/MM/yyyy}'}" FontWeight="Bold" Width="120" />
                            <DataGridTextColumn Header="Paciente" Binding="{Binding Paciente.Nombre}" FontWeight="SemiBold" Width="120" />
                            <DataGridTextColumn Header="Biológico / Vacuna" Binding="{Binding NombreProducto}" Width="160" />
                            <DataGridTextColumn Header="Acudiente" Binding="{Binding Paciente.Propietario.NombreCompleto}" Width="*" />
                            <DataGridTextColumn Header="Teléfono Móvil" Binding="{Binding Paciente.Propietario.Telefono}" Width="110" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Separador -->
            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent" />

            <!-- Panel Lateral de Previsualización y Lanzadores (wa.me y mailto:) -->
            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Previsualización del Aviso"
                               FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource DarkGreenBrush}"
                               Margin="0,0,0,12" />

                    <!-- Datos del Destinatario -->
                    <Border Grid.Row="1" Background="#F1F8E9" CornerRadius="6" Padding="10" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="{Binding InmunizacionSeleccionada.Paciente.Propietario.NombreCompleto, FallbackValue='Seleccione un paciente'}"
                                       FontWeight="Bold" FontSize="14" Foreground="{StaticResource DarkGreenBrush}" />
                            <TextBlock Text="{Binding InmunizacionSeleccionada.Paciente.Propietario.Telefono, StringFormat='📱 WhatsApp: {0}', FallbackValue='Sin celular'}"
                                       FontSize="12" Margin="0,2,0,0" />
                            <TextBlock Text="{Binding InmunizacionSeleccionada.Paciente.Propietario.Email, StringFormat='✉️ Correo: {0}', TargetNullValue='Sin correo registrado'}"
                                       FontSize="12" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Mensaje Generado Dinámicamente -->
                    <TextBox Grid.Row="2"
                             Text="{Binding MensajePrevisualizado, Mode=TwoWay}"
                             IsReadOnly="False"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             Margin="0,0,0,16" />

                    <!-- Botón Enviar WhatsApp (RF-11, RN-09) -->
                    <Button Grid.Row="3"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Height="42" Margin="0,0,0,8"
                            Command="{Binding EnviarWhatsAppCommand}"
                            CommandParameter="{Binding InmunizacionSeleccionada}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="💬 " FontSize="16" VerticalAlignment="Center" />
                            <TextBlock Text="Enviar Recordatorio por WhatsApp" VerticalAlignment="Center" Margin="6,0,0,0" />
                        </StackPanel>
                    </Button>

                    <!-- Botón Enviar Correo (RF-11, RN-09) -->
                    <Button Grid.Row="4"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Height="38"
                            Command="{Binding EnviarCorreoCommand}"
                            CommandParameter="{Binding InmunizacionSeleccionada}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="✉️ " FontSize="14" VerticalAlignment="Center" />
                            <TextBlock Text="Enviar por Correo Electrónico" VerticalAlignment="Center" Margin="6,0,0,0" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
