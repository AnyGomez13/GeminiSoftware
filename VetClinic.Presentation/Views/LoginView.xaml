<Window x:Class="VetClinic.Presentation.Views.LoginView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:behaviors="clr-namespace:VetClinic.Presentation.Behaviors"
        xmlns:viewmodels="clr-namespace:VetClinic.Presentation.ViewModels"
        mc:Ignorable="d"
        Title="VetClinic Pro - Autenticación de Acceso"
        Height="440" Width="480"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackgroundBrush}">

    <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
        <!-- Tarjeta de Autenticación -->
        <Border Style="{StaticResource CardBorderStyle}" Width="400" Padding="32">
            <StackPanel>
                <!-- Logotipo / Membrete -->
                <TextBlock Text="VetClinic Pro" FontSize="22" FontWeight="Bold" Foreground="{StaticResource DarkGreenBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="Sistema de Gestión Clínica Veterinaria" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,2,0,20" />

                <!-- Campo Usuario -->
                <TextBlock Text="Usuario" Style="{StaticResource LabelTextStyle}" />
                <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,16" />

                <!-- Campo Contraseña -->
                <TextBlock Text="Contraseña" Style="{StaticResource LabelTextStyle}" />
                <PasswordBox behaviors:PasswordHelper.Attach="True"
                             behaviors:PasswordHelper.Password="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,16" />

                <!-- Mensaje de Error (CU-01) -->
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{StaticResource ErrorBrush}"
                           FontSize="13"
                           FontWeight="Medium"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,0,0,16"
                           Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <!-- Botón Iniciar Sesión -->
                <Button Content="Iniciar Sesión"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding LoginCommand}"
                        IsDefault="True" />

                <!-- Barra de Progreso Indeterminada -->
                <ProgressBar Height="4"
                             IsIndeterminate="True"
                             Margin="0,16,0,0"
                             Foreground="{StaticResource PrimaryGreenBrush}"
                             Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
